# ---------------------------------------------------------------------------
# DocFlow AI — copy to .env and fill in. NEVER commit .env.
# ---------------------------------------------------------------------------

ENVIRONMENT=local
DEBUG=true
LOG_LEVEL=INFO

# --- Security -------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=dev-only-insecure-change-me-0123456789abcdefghijklmnopqrstuvwxyz
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# --- Database -------------------------------------------------------------
# App role: RLS is FORCEd against this role.
DATABASE_URL=postgresql+asyncpg://docflow:docflow@localhost:5432/docflow
# Migration role: needs BYPASSRLS / table ownership.
DATABASE_ADMIN_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/docflow

# --- Redis ----------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# --- Object storage (MinIO locally, Cloudflare R2 in production) ----------
S3_ENDPOINT_URL=http://localhost:9000
S3_REGION=auto
S3_ACCESS_KEY_ID=docflow
S3_SECRET_ACCESS_KEY=docflow123
S3_BUCKET=docflow
S3_PUBLIC_BASE_URL=http://localhost:9000/docflow

# --- LLM providers --------------------------------------------------------
# Leave blank to run in DEMO_MODE (fixtures, zero API calls).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Tier -> model routing. See docs/10-architecture.md §8.5
LLM_TIER_FAST=anthropic:claude-haiku-4-5
LLM_TIER_BALANCED=anthropic:claude-sonnet-5
LLM_TIER_DEEP=anthropic:claude-opus-5
EMBEDDING_MODEL=openai:text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# --- Cost controls --------------------------------------------------------
MAX_COST_PER_DOCUMENT_USD=2.00
DAILY_BUDGET_PER_WORKSPACE_USD=5.00
FREE_TIER_DOCUMENTS_PER_MONTH=10
FREE_TIER_QUERIES_PER_MONTH=30

# --- Upload limits --------------------------------------------------------
MAX_UPLOAD_BYTES=26214400
MAX_PAGE_COUNT=150

# --- Demo mode ------------------------------------------------------------
# 1 = serve pre-computed analyses from fixtures, never call an LLM.
DEMO_MODE=0

# --- Frontend -------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
API_INTERNAL_URL=http://localhost:8000

# --- Observability (optional) --------------------------------------------
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
