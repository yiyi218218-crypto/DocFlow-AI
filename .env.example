# ---------------------------------------------------------------------------
# DocFlow AI — copy to .env and fill in. NEVER commit .env.
# ---------------------------------------------------------------------------

ENVIRONMENT=local
DEBUG=true
LOG_LEVEL=INFO

# --- Security -------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=dev-only-insecure-change-me-0123456789abcdefghijklmnopqrstuvwxyz
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# --- Database -------------------------------------------------------------
# App role: RLS is FORCEd against this role.
DATABASE_URL=postgresql+asyncpg://docflow:docflow@localhost:5433/docflow
# Migration role: needs BYPASSRLS / table ownership.
DATABASE_ADMIN_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/docflow

# --- Redis ----------------------------------------------------------------
REDIS_URL=redis://localhost:6380/0

# --- Object storage (MinIO locally, Cloudflare R2 in production) ----------
S3_ENDPOINT_URL=http://localhost:9002
S3_REGION=auto
S3_ACCESS_KEY_ID=docflow
S3_SECRET_ACCESS_KEY=docflow123
S3_BUCKET=docflow
S3_PUBLIC_BASE_URL=http://localhost:9002/docflow

# --- LLM providers --------------------------------------------------------
# Leave blank to run in DEMO_MODE (fixtures, zero API calls).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Tier -> model routing. See docs/10-architecture.md §8.5
# OpenAI-only, chosen by measurement (docs/EVALUATION.md §6):
#   gpt-4o-mini  100% citation verification, exact verbatim quotes
#   gpt-4.1-nano 100% verification, most facts, cheapest
#   gpt-5-nano   FAILED - schema invalid after repair, and 5x the cost
LLM_TIER_FAST=openai:gpt-4.1-nano
LLM_TIER_BALANCED=openai:gpt-4o-mini
LLM_TIER_DEEP=openai:gpt-4.1-mini
EMBEDDING_MODEL=openai:text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# --- Cost controls --------------------------------------------------------
# Sized for a free-tier deployment. Measured cost is ~$0.0007 per short
# document, so $0.25/day is ~350 documents - far above real demo usage while
# capping a runaway loop or an abusive uploader at pocket change.
MAX_COST_PER_DOCUMENT_USD=0.10
DAILY_BUDGET_PER_WORKSPACE_USD=0.25
FREE_TIER_DOCUMENTS_PER_MONTH=20
FREE_TIER_QUERIES_PER_MONTH=50

# --- Upload limits --------------------------------------------------------
MAX_UPLOAD_BYTES=10485760
MAX_PAGE_COUNT=30

# --- Demo mode ------------------------------------------------------------
# 1 = serve pre-computed analyses from fixtures, never call an LLM.
DEMO_MODE=0

# --- Frontend -------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
API_INTERNAL_URL=http://localhost:8000

# --- Observability (optional) --------------------------------------------
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
